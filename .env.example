# Copy to ".env" in this folder (same directory as package.json).

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Must match the URL you open in the browser (include port), so reset links work:
WEB_BASE_URL=http://localhost:3000

# --- Database ---
USE_SQLITE_FOR_DEV=true
# DATABASE_URL=postgresql+psycopg2://charity:charity_dev@localhost:5432/charity_insights

# --- SMTP (Gmail): forgot-password emails ---
# 1) Google Account → Security → enable 2-Step Verification
# 2) Security → App passwords → generate for “Mail” / “Other” → copy the 16-character password (spaces optional)
# 3) Fill SMTP_USER and SMTP_FROM_EMAIL with your full Gmail address; SMTP_PASSWORD = app password only (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=ollama
